# Copy these names into your hosting provider's secret/environment settings.
# Never commit a real production .env file.
DOMAIN=fuelwise.com.tr
APP_NAME=FuelWise API
ENVIRONMENT=production
POSTGRES_DB=fuelwise
POSTGRES_USER=fuelwise
POSTGRES_PASSWORD=use-a-unique-url-safe-database-password
DATABASE_URL=postgresql+psycopg://fuelwise:use-a-unique-url-safe-database-password@postgres:5432/fuelwise
JWT_SECRET_KEY=generate-a-unique-random-secret-with-at-least-48-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ALLOWED_ORIGINS=https://fuelwise.com.tr,https://www.fuelwise.com.tr

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=fuelwise.support@gmail.com
SMTP_PASSWORD=set-this-in-the-hosting-provider-secret-store
SMTP_FROM_EMAIL=fuelwise.support@gmail.com
SMTP_STARTTLS=true

PASSWORD_RESET_CODE_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
RATE_LIMIT_ENABLED=true
# The production Compose stack uses Caddy as the trusted reverse proxy.
RATE_LIMIT_TRUST_PROXY_HEADERS=true
LOG_LEVEL=INFO
