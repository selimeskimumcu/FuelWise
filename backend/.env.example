APP_NAME=FuelWise API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://fuelwise:fuelwise_dev_password@localhost:5433/fuelwise
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=fuelwise.support@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=fuelwise.support@gmail.com
SMTP_STARTTLS=true
PASSWORD_RESET_CODE_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
RATE_LIMIT_ENABLED=true
# Enable only when a trusted reverse proxy overwrites X-Forwarded-For.
RATE_LIMIT_TRUST_PROXY_HEADERS=false
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Leave blank locally. In production, set only when sharing cookies across subdomains.
COOKIE_DOMAIN=
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
