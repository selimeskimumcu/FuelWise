{$DOMAIN} {
    encode zstd gzip
    reverse_proxy app:8000 {
        # Overwrite rather than append, so the app never sees a
        # client-supplied X-Forwarded-For entry.
        header_up X-Forwarded-For {remote_host}
    }

    log {
        output stdout
        format json
    }
}

www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}
